// Clinic Appointment and Medical Record Management System
// Database Schema with RFID Integration

generator client {
  provider = "prisma-client-js"
  output   = "C:/Users/Ylo/AppData/Local/Temp/clinic-project-bro-prisma-client-leave"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================================

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
  NURSE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // Hashed password (use bcrypt)
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  staffProfile        StaffProfile?
  createdAppointments Appointment[]   @relation("CreatedByUser")
  medicalRecords      MedicalRecord[] @relation("DoctorRecords")
  prescriptions       Prescription[]  @relation("PrescribedByDoctor")

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================================
// PATIENT MANAGEMENT
// ============================================================

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Demographics
  firstName   String
  lastName    String
  middleName  String?
  dateOfBirth DateTime
  gender      String // MALE, FEMALE, OTHER
  phoneNumber String
  address     String
  city        String
  state       String
  zipCode     String

  // Medical Information
  bloodType         BloodType @default(UNKNOWN)
  allergies         String? // JSON array of allergies
  chronicConditions String? // JSON array of conditions

  // Emergency Contact
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rfidCards      RfidCard[]
  appointments   Appointment[]
  queueTickets   QueueTicket[]
  medicalRecords MedicalRecord[]

  @@index([userId])
  @@index([lastName, firstName])
  @@index([phoneNumber])
  @@map("patient_profiles")
}

// ============================================================
// RFID CARD MANAGEMENT
// ============================================================

enum RfidCardStatus {
  ACTIVE
  REVOKED
  LOST
  EXPIRED
}

model RfidCard {
  id      String         @id @default(cuid())
  cardUid String         @unique // Unique hexadecimal identifier (e.g., "A1B2C3D4")
  status  RfidCardStatus @default(ACTIVE)

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([cardUid])
  @@index([patientId])
  @@index([status])
  @@map("rfid_cards")
}

// ============================================================
// DOCTOR MANAGEMENT
// ============================================================

model DoctorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  specialization String // e.g., "Cardiology", "Pediatrics", "General Medicine"
  licenseNumber  String  @unique
  roomNumber     String? // Consultation room assignment

  isActive      Boolean @default(true)
  availableFrom String? // Time in HH:mm format, e.g., "09:00"
  availableTo   String? // Time in HH:mm format, e.g., "17:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  appointments       Appointment[]
  queueTickets       QueueTicket[]
  schedule           DoctorSchedule?
  scheduleExceptions DoctorScheduleException[]
  leaveRequests      DoctorLeaveRequest[]

  @@index([userId])
  @@index([specialization])
  @@index([isActive])
  @@map("doctor_profiles")
}

enum ScheduleExceptionType {
  LEAVE
  HOLIDAY
  UNAVAILABLE
}

model DoctorSchedule {
  id                String        @id @default(cuid())
  doctorId          String        @unique
  doctor            DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotDuration      Int           @default(30)
  maxPatientsPerDay Int           @default(20)
  bufferMinutes     Int           @default(0)
  timezone          String        @default("Asia/Manila")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  weeklyAvailability DoctorWeeklyAvailability[]

  @@index([doctorId])
  @@map("doctor_schedules")
}

model DoctorWeeklyAvailability {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  enabled    Boolean        @default(true)
  startTime  String
  endTime    String
  breakStart String?
  breakEnd   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
  @@map("doctor_weekly_availability")
}

model DoctorScheduleException {
  id        String                @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime              @db.Date
  type      ScheduleExceptionType
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([doctorId, date])
  @@map("doctor_schedule_exceptions")
}

model DoctorLeaveRequest {
  id          String        @id @default(cuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  message     String
  status      String        @default("PENDING")
  adminReply  String?
  exceptionId String?
  createdAt   DateTime      @default(now())
  reviewedAt  DateTime?

  @@index([doctorId, date])
  @@index([status, createdAt])
  @@map("doctor_leave_requests")
}

// ============================================================
// STAFF MANAGEMENT (Nurses, Receptionists, Administrative Staff)
// ============================================================

model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  specialty     String? // e.g. "Triage / Vital Signs", "Pediatrics Nurse", "Front Desk Registration", "Admissions & Billing"
  roomNumber    String? // e.g. "Triage Station 1", "Counter 1", "Front Desk Desk A", "Vital Signs Booth"
  phoneNumber   String?
  licenseNumber String? // e.g. PRC RN-0123456 for registered nurses

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("staff_profiles")
}

// ============================================================
// APPOINTMENT MANAGEMENT
// ============================================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id String @id @default(cuid())

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  appointmentDate DateTime // Date and time of appointment
  duration        Int      @default(30) // Duration in minutes

  status         AppointmentStatus @default(SCHEDULED)
  reasonForVisit String
  notes          String?

  createdById String
  createdBy   User   @relation("CreatedByUser", fields: [createdById], references: [id])

  confirmedAt        DateTime?
  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  queueTicket    QueueTicket?
  medicalRecords MedicalRecord[]

  @@unique([doctorId, appointmentDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@index([appointmentDate, doctorId])
  @@map("appointments")
}

// ============================================================
// QUEUE MANAGEMENT
// ============================================================

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

model QueueTicket {
  id String @id @default(cuid())

  queueNumber Int // Daily auto-incrementing number
  queueDate   DateTime @default(now()) @db.Date // Date component only

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  status   QueueStatus @default(WAITING)
  priority Int         @default(0) // Higher number = higher priority (for emergencies)
  station  String? // e.g., "Consultation Room 1"

  calledAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  estimatedWaitMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([queueDate, queueNumber])
  @@index([patientId])
  @@index([doctorId])
  @@index([queueDate, status])
  @@index([status])
  @@map("queue_tickets")
}

// ============================================================
// MEDICAL RECORDS (SOAP Notes)
// ============================================================

model MedicalRecord {
  id String @id @default(cuid())

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("DoctorRecords", fields: [doctorId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  visitDate DateTime @default(now())

  // SOAP Notes
  subjective String // Chief complaint, patient's description
  objective  String // Physical examination findings
  assessment String // Diagnosis or clinical impression
  plan       String // Treatment plan, recommendations

  // Vitals (stored as JSONB for flexibility)
  vitals Json? // { "temperature": 37.5, "bloodPressure": "120/80", "heartRate": 72, "weight": 70, "height": 170 }

  followUpDate  DateTime?
  followUpNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prescriptions Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
  @@index([appointmentId])
  @@map("medical_records")
}

// ============================================================
// PRESCRIPTION MANAGEMENT
// ============================================================

model Prescription {
  id String @id @default(cuid())

  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("PrescribedByDoctor", fields: [doctorId], references: [id])

  medicationName String
  dosage         String // e.g., "500mg"
  frequency      String // e.g., "Twice daily", "Every 8 hours"
  duration       String // e.g., "7 days", "2 weeks"
  instructions   String? // Additional instructions
  quantity       Int? // Total quantity prescribed

  prescribedDate DateTime  @default(now())
  startDate      DateTime  @default(now())
  endDate        DateTime?

  isActive Boolean @default(true)

  // Immutable e-signature audit trail captured when the prescription is issued.
  eSignedAt         DateTime?
  eSignatureName    String?
  eSignatureLicense String?
  eSignatureHash    String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicalRecordId])
  @@index([doctorId])
  @@index([prescribedDate])
  @@index([eSignedAt])
  @@map("prescriptions")
}

// ============================================================
// SYSTEM & ADMIN NOTIFICATIONS
// ============================================================

model ClinicSettings {
  id              String   @id @default("default")
  clinicName      String   @default("Laguna Medical Center")
  shortName       String   @default("LMC")
  hotline         String   @default("(049) 545-8888")
  address         String   @default("Santa Cruz, Laguna, Philippines")
  emergencyNotice String   @default("For emergencies, call 911 or visit the nearest hospital.")
  queueResetTime  String   @default("00:00")
  queuePrefixes   Json
  timezone        String   @default("Asia/Manila")
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("clinic_settings")
}

model AdminNotification {
  id             String   @id @default(cuid())
  type           String   @default("info") // "info" | "success" | "warning" | "error"
  category       String   @default("STAFF_LOGIN") // "STAFF_LOGIN", "SYSTEM", etc.
  title          String
  message        String
  staffName      String?
  staffEmail     String?
  staffRole      String?
  staffSpecialty String?
  staffRoom      String?
  metadata       Json?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@map("admin_notifications")
}

// ============================================================
// TRIAGE ASSESSMENT & CLINICAL ROUTING
// ============================================================

model TriageAssessment {
  id           String  @id @default(cuid())
  triageNumber String  @unique // e.g. "TRG-20260924-001"
  patientId    String?
  patientName  String
  age          Int?
  gender       String? // "MALE", "FEMALE"
  cardUid      String?

  // Vital Signs
  bloodPressure    String? // e.g. "120/80"
  heartRate        String? // e.g. "78"
  temperature      String? // e.g. "36.8"
  respiratoryRate  String? // e.g. "18"
  oxygenSaturation String? // e.g. "98"
  weightKg         String? // e.g. "62"
  heightCm         String? // e.g. "165"
  bmi              String? // e.g. "22.8"

  // Clinical Chief Complaint & Assessment
  chiefComplaint   String
  symptomsDuration String? // e.g. "3 days", "1 week"
  painScore        Int     @default(0) // 0-10 pain scale

  // Routing
  department    String // "OB_GYN", "PEDIATRICS", "INTERNAL_MEDICINE", "SURGERY", "EENT"
  priorityLevel String @default("STANDARD") // "RESUSCITATION", "URGENT", "PRIORITY", "STANDARD"

  nurseId          String?
  nurseName        String?
  status           String  @default("PENDING_OPD") // "PENDING_OPD", "OPD_PROCESSED", "COMPLETED"
  opdQueueTicketId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([patientId])
  @@map("triage_assessments")
}
