# Copy these names into the protected staging environment or secret manager.
# Never commit real values.
DEPLOYMENT_ENV="staging"
APP_RELEASE="staging-build-id"
DATABASE_URL="postgresql://staging-user:replace-me@staging-db.example:5432/clinic_staging?sslmode=require"
NEXTAUTH_URL="https://staging-clinic.example.com"
NEXTAUTH_SECRET="replace-with-32-plus-random-characters"
RATE_LIMIT_PEPPER="replace-with-an-independent-32-plus-character-secret"
MFA_ENCRYPTION_KEY="replace-with-a-64-character-hex-key"
CRON_SECRET="replace-with-32-plus-random-characters"
REQUIRE_STAFF_PASSWORD_ACTIVATION="true"
REQUIRE_STAFF_MFA="false"

# Email: configure one provider.
EMAIL_FROM="Laguna Medical Center Staging <staging@example.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Central monitoring and alerts. HTTPS is required in production.
ERROR_MONITOR_WEBHOOK_URL="https://monitoring.example.com/hooks/errors"
ALERT_WEBHOOK_URL="https://monitoring.example.com/hooks/alerts"

# Patient app and account links must stay isolated from production.
NEXT_PUBLIC_API_URL="https://staging-clinic.example.com"
EXPO_PUBLIC_API_URL="https://staging-clinic.example.com"
MOBILE_ACCOUNT_URL="lagunamedical-staging://account"
